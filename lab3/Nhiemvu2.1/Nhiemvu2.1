import base64


# =========================
# 1. Euclid mo rong
# =========================
def egcd(a, b):
    if b == 0:
        return a, 1, 0

    g, x1, y1 = egcd(b, a % b)

    x = y1
    y = x1 - (a // b) * y1

    return g, x, y


# =========================
# 2. Tim nghich dao modulo
# =========================
def mod_inverse(a, m):
    g, x, y = egcd(a, m)

    if g != 1:
        raise ValueError("Khong ton tai nghich dao modulo")

    return x % m


# =========================
# 3. Tao khoa RSA
# =========================
def tao_khoa_rsa(p, q, e):
    n = p * q
    phi = (p - 1) * (q - 1)
    d = mod_inverse(e, phi)

    public_key = (e, n)
    private_key = (d, n)

    return public_key, private_key, phi


# =========================
# 4. Ma hoa / giai ma 1 so nguyen
# =========================
def rsa_encrypt_number(M, key):
    so_mu, n = key
    return pow(M, so_mu, n)


def rsa_decrypt_number(C, key):
    so_mu, n = key
    return pow(C, so_mu, n)


# =========================
# 5. So byte can dung de luu 1 block ciphertext
# =========================
def cipher_block_size(n):
    return (n.bit_length() + 7) // 8


# =========================
# 6. Ma hoa chuoi sang Base64
# Moi byte plaintext duoc ma hoa thanh 1 block RSA
# Cach nay de hieu va phu hop voi khoa nho p1, vi ASCII < 187
# =========================
def rsa_encrypt_text_to_base64(text, public_key):
    e, n = public_key
    c_size = cipher_block_size(n)

    ciphertext_bytes = b""

    for b in text.encode("utf-8"):
        if b >= n:
            raise ValueError("Byte plaintext lon hon n, khong ma hoa duoc voi khoa nay")

        c = pow(b, e, n)
        ciphertext_bytes += c.to_bytes(c_size, "big")

    return base64.b64encode(ciphertext_bytes).decode("utf-8")


# =========================
# 7. Giai ma Base64 ve chuoi
# =========================
def rsa_decrypt_base64_to_text(cipher_b64, private_key):
    d, n = private_key
    c_size = cipher_block_size(n)

    ciphertext_bytes = base64.b64decode(cipher_b64)

    if len(ciphertext_bytes) % c_size != 0:
        raise ValueError("Ciphertext khong chia het cho kich thuoc block")

    plaintext_bytes = b""

    for i in range(0, len(ciphertext_bytes), c_size):
        block = ciphertext_bytes[i:i + c_size]
        c = int.from_bytes(block, "big")
        m = pow(c, d, n)
        plaintext_bytes += bytes([m])

    return plaintext_bytes.decode("utf-8")


# =========================
# 8. Chuyen ciphertext de bai ve bytes
# =========================
def parse_ciphertext(s):
    s = s.strip().replace("\n", "").replace(" ", "")

    # Neu la chuoi nhi phan
    if all(ch in "01" for ch in s):
        return int(s, 2).to_bytes((len(s) + 7) // 8, "big"), "binary"

    # Neu la chuoi hex
    hex_chars = "0123456789abcdefABCDEF"
    if len(s) % 2 == 0 and all(ch in hex_chars for ch in s):
        return bytes.fromhex(s), "hex"

    # Con lai xem nhu Base64
    return base64.b64decode(s), "base64"


# =========================
# 9. Thu giai ma ciphertext voi 1 khoa RSA
# =========================
def try_decrypt_ciphertext(ciphertext_str, private_key):
    d, n = private_key
    c_size = cipher_block_size(n)

    raw, kieu = parse_ciphertext(ciphertext_str)

    if len(raw) % c_size != 0:
        return None

    plaintext_bytes = b""

    for i in range(0, len(raw), c_size):
        block = raw[i:i + c_size]
        c = int.from_bytes(block, "big")

        if c >= n:
            return None

        m = pow(c, d, n)

        if m < 0 or m > 255:
            return None

        plaintext_bytes += bytes([m])

    try:
        return plaintext_bytes.decode("utf-8")
    except UnicodeDecodeError:
        return None


